# VulnScanner Backend Environment Variables
# Copy this file to .env and fill in values

# Server settings
HOST=0.0.0.0
PORT=8000

# Optional: Set to false in production to disable reload
RELOAD=true

# Optional: Max concurrent scans (future feature)
MAX_CONCURRENT_SCANS=5

# Optional: Scan timeout per stage in seconds
SCAN_TIMEOUT=60
